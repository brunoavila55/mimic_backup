# Required: choose a strong, unique database password.
POSTGRES_PASSWORD=

# Required: at least 32 random characters. Keep this value stable and backed up.
SECRET_KEY=

# Enable this when the application is served through HTTPS.
COOKIE_SECURE=false

# Recommended behind a reverse proxy:
# APP_ORIGIN=https://mimic.example.com

TZ=America/Sao_Paulo
EXTERNAL_PORT=3000
# Set to true after running `npm run build` in ./frontend. The container image
# enables this automatically; false keeps the Go Template routes active.
SPA_ENABLED=false
